#!/bin/sh
# CalLink AppImage entry point.
#   ./CalLink-x86_64.AppImage              → the GUI
#   ./CalLink-x86_64.AppImage --cli ARGS   → the command-line tool (callink-cli ARGS)
HERE="$(dirname "$(readlink -f "$0")")"
if [ "$1" = "--cli" ]; then
    shift
    exec "$HERE/usr/bin/callink-cli" "$@"
fi
exec "$HERE/usr/bin/callink" "$@"
